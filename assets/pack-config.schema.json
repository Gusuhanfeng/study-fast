{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pack-config.schema.json",
  "title": "Study Fast pack configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["scene", "topic", "selection", "privacy", "documents"],
  "properties": {
    "scene": {
      "enum": ["knowledge_point", "exam_prep", "job_interview", "work_onboarding", "weekly_progress", "meeting_prep"]
    },
    "topic": {"type": "string", "minLength": 1},
    "template": {"enum": ["formal_zh_cn", "formal_cross_platform"]},
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "subtitle": {"type": "string"},
        "date": {"type": "string"},
        "scene_label": {"type": "string"},
        "language": {"enum": ["zh-CN", "en"]}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["practice_needed", "practice_reason"],
      "properties": {
        "output_mode": {"enum": ["full_pack", "selected"]},
        "requested_documents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["study_handbook", "teaching_narrative", "practice_guide"]}
        },
        "practice_needed": {"type": "boolean"},
        "practice_reason": {"type": "string", "minLength": 1}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["balanced", "strict"]},
        "prohibited_terms": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "claim", "source"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "status": {"enum": ["VERIFIED", "USER_STATED", "INFERRED", "UNKNOWN"]},
          "claim": {"type": "string", "minLength": 1},
          "source": {"type": "string", "minLength": 1}
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/document"}
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_type", "filename", "title", "sections"],
      "properties": {
        "document_type": {"enum": ["study_handbook", "teaching_narrative", "practice_guide"]},
        "filename": {"type": "string", "pattern": "\\.docx$"},
        "title": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/section"}
        }
      }
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "content"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "content": {
          "type": "array",
          "items": {"type": "object", "required": ["type"]}
        }
      }
    }
  }
}
