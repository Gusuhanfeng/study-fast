{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Study Fast optional interactive quiz",
  "type": "object",
  "additionalProperties": false,
  "required": ["bank_id", "title", "questions"],
  "properties": {
    "bank_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"},
    "title": {"type": "string", "minLength": 1},
    "questions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "category", "question", "answer"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "question": {"type": "string", "minLength": 1},
          "answer": {"type": "string", "minLength": 1},
          "criteria": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "learning": {
            "type": "object", "additionalProperties": false, "minProperties": 1,
            "properties": {
              "concept": {"type": "string", "minLength": 1},
              "method": {"type": "string", "minLength": 1},
              "explanation": {"type": "string", "minLength": 1},
              "example": {"type": "string", "minLength": 1},
              "pitfalls": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
